# Cloud save is configured in Vercel environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_REST_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SAVES_TABLE=saves

# EmailJS is configured in Vercel environment variables.
# Set EMAILJS_PUBLIC_KEY once if both templates use the same key.
EMAILJS_PUBLIC_KEY=
EMAILJS_FEEDBACK_PUBLIC_KEY=
EMAILJS_FEEDBACK_SERVICE_ID=
EMAILJS_FEEDBACK_TEMPLATE_ID=
EMAILJS_NEW_PLAYER_PUBLIC_KEY=
EMAILJS_NEW_PLAYER_SERVICE_ID=
EMAILJS_NEW_PLAYER_TEMPLATE_ID=

# Server-only variables for the Supabase welcome-email webhook.
# Configure these in Vercel; never prefix them with VITE_ or NEXT_PUBLIC_.
SUPABASE_WEBHOOK_SECRET=
RESEND_API_KEY=
